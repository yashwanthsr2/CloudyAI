# Backend Environment Variables
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Supabase Configuration (Obtain from your Supabase Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=privacloud-storage

# Real Email Delivery Configuration (To send real 6-digit OTPs to real Gmail / Outlook inboxes)
# For Gmail: Generate a 16-character App Password at:
# https://myaccount.google.com/apppasswords (Requires 2-Step Verification)
SMTP_SERVICE=gmail
SMTP_USER=your-email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM="AI CLOUD DRIVE Security" <your-email@gmail.com>

# Or for Custom / Corporate SMTP:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@domain.com
# SMTP_PASS=your-password

# Optional: Set to true to run backend in standalone offline mode with local storage mock
# USE_LOCAL_MOCK=false
